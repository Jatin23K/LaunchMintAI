# ── Gemini API Keys (one per Gmail/GCP project for rate-limit rotation) ──────
# Get keys at: https://aistudio.google.com/app/apikey
# Strategy: PRIMARY (gemini-2.5-flash) tries all 6 keys → fallback to SECONDARY (gemini-2.5-flash-lite)
GEMINI_API_KEY_1=your_key_from_gmail_1
GEMINI_API_KEY_2=your_key_from_gmail_2
GEMINI_API_KEY_3=your_key_from_gmail_3
GEMINI_API_KEY_4=your_key_from_gmail_4
GEMINI_API_KEY_5=your_key_from_gmail_5
GEMINI_API_KEY_6=your_key_from_gmail_6

# ── Search (Tavily) ──────────────────────────────────────────────────────────
# Get key at: https://tavily.com (free: 1,000 searches/month)
TAVILY_API_KEY=your_tavily_key
